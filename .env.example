PORT=3008

# Postgres (docker-compose + TypeORM читають ці самі змінні)
POSTGRES_USER=schemka
POSTGRES_PASSWORD=schemka
POSTGRES_DB=schemka
POSTGRES_PORT=5444

# Хост БД з боку застосунку: localhost для локального запуску,
# або імʼя сервісу (postgres), якщо апка теж поїде в compose.
DB_HOST=localhost

DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
DB_SSL=false
