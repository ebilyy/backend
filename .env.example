PORT=3008

# Postgres (docker-compose + TypeORM читають ці самі змінні)
POSTGRES_USER=schemka
POSTGRES_PASSWORD=schemka
POSTGRES_DB=schemka
POSTGRES_PORT=5444

# Хост БД з боку застосунку: localhost для локального запуску,
# або імʼя сервісу (postgres), якщо апка теж поїде в compose.
DB_HOST=localhost

DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
DB_SSL=false

# Origin-и фронту через кому. Порожньо — при npm run start:dev дозволені всі,
# а з NODE_ENV=production CORS вимкнено (фронт і API на одному домені).
# docker-compose збирає production-образ, тому там дефолт http://localhost:5173.
CORS_ORIGINS=

# Сховище файлів — Garage (S3). docker-compose піднімає його з цими ж ключем
# і бакетом; у проді значення беруться з сервісу Garage у Coolify.
S3_ENDPOINT=http://localhost:0000
S3_REGION=****
S3_BUCKET=***
S3_ACCESS_KEY_ID=***
S3_SECRET_ACCESS_KEY=***
